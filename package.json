{
  "name": "claude-code-scheduler-vscode",
  "displayName": "Claude Code Scheduler",
  "description": "Schedule Claude Code tasks from VS Code: run them each time your 5-hour usage window resets, or at a specific date and time.",
  "version": "0.2.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "author": "mohmedofficial515",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohmedofficial515/claude-code-scheduler-vscode.git"
  },
  "homepage": "https://github.com/mohmedofficial515/claude-code-scheduler-vscode#readme",
  "bugs": {
    "url": "https://github.com/mohmedofficial515/claude-code-scheduler-vscode/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "scheduler",
    "automation",
    "arabic",
    "rtl"
  ],
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCompanion.openScheduler",
        "title": "جدولة مهمة كلود",
        "category": "Claude Code Scheduler",
        "icon": "$(clock)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "claudeCompanion.openScheduler",
          "when": "activeWebviewPanelId == 'claudeVSCodePanel'",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeCompanion.openScheduler"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Scheduler",
      "properties": {
        "claudeCompanion.schedulerDir": {
          "type": "string",
          "default": "f:\\AI\\auto-code\\claude-scheduler",
          "description": "Folder containing claude-code-scheduler (run-watcher.ps1, config.json, task.md)."
        }
      }
    }
  },
  "scripts": {}
}
